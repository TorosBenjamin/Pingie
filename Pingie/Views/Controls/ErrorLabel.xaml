<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:Pingie.Maui.Utils"
             x:Class="Pingie.Maui.Views.Controls.ErrorLabel">
    <Grid ColumnDefinitions="Auto, *"
          ColumnSpacing="5"
          IsVisible="{Binding HasError}"
          BackgroundColor="Transparent">
        <utils:SvgImage Grid.Column="0"
                        Source="exclamation.svg"
                        IsIcon="True"
                        HeightRequest="15"
                        WidthRequest="15"
                        TintColor="{DynamicResource Error}"
        />
        <Label Grid.Column="1"
               Text="{Binding ErrorMessage}"
               TextColor="{DynamicResource Error}"/>
    </Grid>
</ContentView>