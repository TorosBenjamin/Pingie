<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Pingie.Maui.Views.Controls"
             xmlns:extensions="clr-namespace:Pingie.Maui.Views.Controls.Extensions"
             x:Class="Pingie.Maui.Views.Controls.ValidatableEntry"
             x:Name="Root">
    <Grid RowDefinitions="Auto, Auto" 
          ColumnDefinitions="*"
          RowSpacing="4"
          HorizontalOptions="Fill">
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource SecondaryBackGround}"
                Stroke="{DynamicResource PrimaryText}"
                HorizontalOptions="Fill"
                StrokeShape="RoundRectangle 3"
                StrokeThickness="0.8"
                Padding="5, 0">
            <Entry
                Text="{Binding Text, Source={x:Reference Root},Mode=TwoWay}"
                Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                TextColor="{DynamicResource PrimaryText}"
                PlaceholderColor="{DynamicResource TertiaryText}"
                FontSize="16"
                extensions:EntryExtensions.CursorColor="{DynamicResource PrimaryAccent}"
                HorizontalOptions="Fill"
            />
            
        </Border>
        <controls:ErrorLabel Grid.Row="1"
                             x:Name="ErrorLabel"
                             HorizontalOptions="Fill"/>
    </Grid>
</ContentView>