<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Pingie.Maui.Views"
             xmlns:controls="clr-namespace:Pingie.Maui.Views.Controls"
             x:Class="Pingie.Maui.Views.BasePage">
    
    <Grid RowDefinitions="Auto,*, Auto">
        <ContentView Grid.Row="0"
                     Content="{x:Static views:BasePage.NavigationBar}"
                     ZIndex="2"/>
        <ContentView Grid.Row="1"
                     Margin="0,-10,0,0"
                     Padding="0, 17, 0, 0"
                     BackgroundColor="{DynamicResource Background}"
                     Content="{Binding CurrentPageContent}" 
                     ZIndex="1"/>
    </Grid>
</ContentPage>
