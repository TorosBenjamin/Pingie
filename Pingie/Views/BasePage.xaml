<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Pingie.Maui.Views"
             x:Class="Pingie.Maui.Views.BasePage">

    <Grid RowDefinitions="Auto,*">
        <views:NavigationBar Grid.Row="0" ZIndex="2"/>
        <Border
            Grid.Row="1"
            Margin="0,-8,0,0"
            Padding="0, 18, 0, 0"
            StrokeThickness="0"
            Stroke="Transparent"
            BackgroundColor="{DynamicResource Background}"
            Content="{Binding CurrentPageContent}" ZIndex="1"/>
    </Grid>
</ContentPage>
