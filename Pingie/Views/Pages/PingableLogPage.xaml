<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Pingie.Data.Models;assembly=Data"
             x:Class="Pingie.Maui.Views.PingableLogPage">
    <ContentPage.Content>
        <Border>
            <VerticalStackLayout>
                <CollectionView ItemsSource="{Binding Logs}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:PingResult">
                            <Label Text="{Binding LogMessage}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </ContentPage.Content>
</ContentPage>