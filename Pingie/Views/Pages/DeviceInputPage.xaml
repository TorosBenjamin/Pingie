<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Pingie.Views.Controls"
             xmlns:utils="clr-namespace:Pingie.Utils"
             x:Class="Pingie.Maui.Views.Pages.DeviceInputPage">
    <ScrollView>
        <VerticalStackLayout
            Padding="10, 0">
            <Label
                Text="Add device"
                TextColor="{DynamicResource PrimaryText}"
                FontSize="30"
                HorizontalOptions="Start"
                Margin="0, 0, 0, 20"/>
            <Grid RowDefinitions="Auto, Auto"
                  Margin="0, 10">
                <Label Grid.Row="0"
                    Text="Name:"
                    FontSize="16"/>
                <controls:ValidatableEntry x:Name="NameEntry" 
                                           Grid.Row="1"
                                           Text="{Binding Name}" 
                                           Placeholder="laptop"
                                           WidthRequest="200"
                                           HorizontalOptions="Start">
                    <controls:ValidatableEntry.ValidationAndErrors>
                        <utils:ValidationErrorRule Validator="{x:Static utils:StringValidators.IsNotEmpty}" Error="Name is required." />
                        <utils:ValidationErrorRule Validator="{x:Static utils:StringValidators.MaxLength30}" Error="Name max length is 30."/>
                    </controls:ValidatableEntry.ValidationAndErrors>
                </controls:ValidatableEntry>
            </Grid>
            <Grid RowDefinitions="Auto, Auto"
                  Margin="0, 10">
                <Label Grid.Row="0"
                       Text="Host Name:"
                       FontSize="16"/>
                <controls:ValidatableEntry x:Name="HostNameEntry" 
                                           Grid.Row="1"
                                           Text="{Binding Name}" 
                                           Placeholder="192.168.0.0"
                                           WidthRequest="200"
                                           HorizontalOptions="Start">
                    <controls:ValidatableEntry.ValidationAndErrors>
                        <utils:ValidationErrorRule Validator="{x:Static utils:StringValidators.IsNotEmpty}" Error="Ip address is required." />
                        <utils:ValidationErrorRule Validator="{x:Static utils:StringValidators.MaxLength30}" Error="Hostname max length is 30."/>
                    </controls:ValidatableEntry.ValidationAndErrors>
                </controls:ValidatableEntry>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>