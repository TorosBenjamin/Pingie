<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:Pingie.Maui.Utils"
             x:Class="Pingie.Maui.Views.Pages.DeviceDetailPage">
    <VerticalStackLayout Padding="20" Spacing="15">
        
    <Grid ColumnDefinitions="*, Auto">
        <Label Text="Name:" Grid.Column="0"
               FontSize="Medium" 
               FontAttributes="Bold" 
               TextColor="{DynamicResource PrimaryText}"/>
        <utils:SvgImage Grid.Column="1"
                        Source="edit.svg"
                        WidthRequest="20"
                        HeightRequest="20"
                        IsIcon="True"
                        TintColor="{DynamicResource PrimaryText}">
            <utils:SvgImage.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnEditTappedCommand}" />
            </utils:SvgImage.GestureRecognizers>
        </utils:SvgImage>
    </Grid>
        <Label Text="{Binding Name}" FontSize="Medium" TextColor="{DynamicResource SecondaryText}"/>

    <Label Text="Hostname:" FontSize="Medium" FontAttributes="Bold" TextColor="{DynamicResource PrimaryText}"/>
    <Label Text="{Binding HostName}" FontSize="Medium" TextColor="{DynamicResource SecondaryText}"/>

    <Label Text="Avg. Response Time (ms):" FontSize="Medium" FontAttributes="Bold" TextColor="{DynamicResource PrimaryText}"/>
    <Label Text="{Binding AvgResponseTime, StringFormat='{0:N2}'}" FontSize="Medium" TextColor="{DynamicResource SecondaryText}"/>

    <Grid ColumnDefinitions="Auto, Auto"
          BackgroundColor="Transparent">
        <utils:SvgImage Grid.Column="0"
                        Source="logs.svg"
                        WidthRequest="20"
                        HeightRequest="20"
                        Margin="0, 0, 5, 0"
                        IsIcon="True"
                        TintColor="{DynamicResource PrimaryAccent}">
        </utils:SvgImage>
        <Label Text="Logs" Grid.Column="1"
               TextColor="{DynamicResource PrimaryAccent}"
               FontAttributes="Bold"
               FontSize="Small"/>

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OnLogsTappedCommand}" />
        </Grid.GestureRecognizers>
    </Grid>
</VerticalStackLayout>

</ContentView>